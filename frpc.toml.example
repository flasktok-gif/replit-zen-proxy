# frp 客户端配置模板
# 复制为 frpc.toml 并填入真实值后使用
# 
# 下载 frpc: curl -LO https://github.com/fatedier/frp/releases/download/v0.61.1/frp_0.61.1_linux_amd64.tar.gz && tar -xzf frp_0.61.1_linux_amd64.tar.gz && mv frp_0.61.1_linux_amd64/frpc . && chmod +x frpc
# 启动: ./frpc -c frpc.toml

serverAddr = "YOUR_SERVER_IP"
serverPort = 7000
auth.method = "token"
auth.token = "YOUR_TOKEN"

[transport]
tls.enable = true

[log]
to = "./frpc.log"
level = "info"
maxDays = 3

[[proxies]]
name = "zen-proxy"
type = "tcp"
localIP = "127.0.0.1"
localPort = 3000
remotePort = 17860

[[proxies]]
name = "ttyd-terminal"
type = "tcp"
localIP = "127.0.0.1"
localPort = 7681
remotePort = 17861