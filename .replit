entrypoint = "index.js"
run = "npm start"
onBoot = "npm install"
language = "nodejs"

[gitHubImport]
requiredFiles = [".replit", "package.json", "index.js"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 7681
externalPort = 7681

[deployment]
build = ["sh", "-c", "npm install"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "cloudrun"